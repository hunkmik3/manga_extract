# Copy this file to `.env` (gitignored) and fill in the values.
# The agent auto-loads `.env` at startup (see agent/flowboard/__init__.py).

# Google Flow public client API key — extracted from the labs.google Flow web
# app, used for aisandbox-pa credits/paygate calls. It is a public client key
# (not a private secret), but kept out of the repo so it isn't published.
FLOWBOARD_FLOW_API_KEY=

# BytePlus Ark (direct) — the "Seedream 5.0 Pro" studio model
# (dola-seedream-5-0-pro-260628), region ap-southeast. Optional ARK_BASE_URL
# overrides the endpoint.
ARK_API_KEY=
# ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com

# Seedream is pay-per-use: the usage badge shows money SPENT. BytePlus
# Dola-Seedream-5.0-pro bills per image — output ~$0.045, input/ref ~$0.003
# (first input free). Override if your pixel tier / price differs.
# FLOWBOARD_SEEDREAM_USD_PER_IMAGE=0.045
# FLOWBOARD_SEEDREAM_USD_PER_INPUT=0.003

# DanceSee B2B (content-filter-disabled Seedream) — manga colorizer default.
# Account must be userType: B2B (manual whitelist). Falls back to AVIS_API_KEY
# if DANCESEE_API_KEY is unset. Models: seedream-4-0 / 4-5 / 5-0 / dola-seedream-5-0-pro.
# DANCESEE_API_KEY=
# DANCESEE_BASE_URL=https://api.dancesee.io
# COLORIZE_PROVIDER=dancesee
# COLORIZE_MODEL=dola-seedream-5-0-pro
